# Nur der Upload-Endpunkt ist öffentlich, UI und API nur aus dem internen Netz (Adressen anpassen).
server {
    listen 443 ssl;
    server_name chairman.meinedomain.de;
    # ssl_certificate     /etc/letsencrypt/live/chairman.meinedomain.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/chairman.meinedomain.de/privkey.pem;

    client_max_body_size 256k;

    location = /marmot/tools/reportDEVICE.php {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /marmot/ {
        allow 10.0.0.0/8;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / { return 404; }
}
